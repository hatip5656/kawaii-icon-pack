{
  "name": "kawaii-icon-pack",
  "version": "1.0.0",
  "description": "Kawaii animal icons \u2014 6 characters with expressions, gestures, verbs, 33 body poses, 25 sports and 43 occupations, plus a kawaii UI set.",
  "keywords": [
    "kawaii",
    "cute",
    "animals",
    "icons",
    "svg",
    "icon-pack",
    "avatar",
    "emoji",
    "mascot",
    "status",
    "presence",
    "ui-icons",
    "stickers",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatip5656/kawaii-icon-pack.git"
  },
  "bugs": {
    "url": "https://github.com/hatip5656/kawaii-icon-pack/issues"
  },
  "homepage": "https://github.com/hatip5656/kawaii-icon-pack#readme",
  "author": "Hatip Aksunger <hatip.aksunger@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./sprite-ui.svg": "./dist/sprite-ui.svg",
    "./sprite-characters.svg": "./dist/sprite-characters.svg",
    "./icons.json": "./icons.json",
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "svg",
    "icons.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "python3 scripts/build_icons.py && python3 scripts/build_js.py && python3 scripts/build_preview.py",
    "prepublishOnly": "npm run build",
    "check": "python3 scripts/check_icons.py"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  }
}
